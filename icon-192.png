<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>P2P Social Icon</title><style>
body{
  margin:0;
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  background:#f4f7f8;
  font-family:Arial,sans-serif;
}

button{
  border:0;
  background:#087f73;
  color:white;
  padding:16px 24px;
  border-radius:14px;
  font-size:17px;
  font-weight:bold;
}
</style></head><body><button onclick="makePNG()">
  Create icon-192.png
</button><script>
function makePNG(){

  const size = 192;

  const canvas = document.createElement("canvas");

  canvas.width = size;
  canvas.height = size;

  const ctx = canvas.getContext("2d");

  /* Background */
  const gradient = ctx.createLinearGradient(
    0,0,size,size
  );

  gradient.addColorStop(0,"#064e46");
  gradient.addColorStop(1,"#10a889");

  ctx.fillStyle = gradient;

  ctx.beginPath();
  ctx.roundRect(
    0,
    0,
    size,
    size,
    48
  );

  ctx.fill();


  /* White P shapes */

  ctx.strokeStyle = "#ffffff";
  ctx.lineWidth = 15;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";


  /* LEFT P */

  ctx.beginPath();

  ctx.moveTo(40,145);
  ctx.lineTo(40,47);
  ctx.lineTo(70,47);

  ctx.arc(
    70,
    72,
    25,
    -Math.PI/2,
    Math.PI/2
  );

  ctx.lineTo(40,97);

  ctx.stroke();


  /* RIGHT P */

  ctx.beginPath();

  ctx.moveTo(152,47);
  ctx.lineTo(122,47);

  ctx.arc(
    122,
    72,
    25,
    -Math.PI/2,
    Math.PI/2,
    true
  );

  ctx.lineTo(152,145);

  ctx.stroke();


  /* CENTER WHITE CIRCLE */

  ctx.fillStyle = "#ffffff";

  ctx.beginPath();

  ctx.arc(
    96,
    96,
    24,
    0,
    Math.PI*2
  );

  ctx.fill();


  /* CENTER GREEN DOT */

  ctx.fillStyle = "#087f73";

  ctx.beginPath();

  ctx.arc(
    96,
    96,
    8,
    0,
    Math.PI*2
  );

  ctx.fill();


  /* DOWNLOAD PNG */

  const link = document.createElement("a");

  link.download = "icon-192.png";

  link.href = canvas.toDataURL("image/png");

  document.body.appendChild(link);

  link.click();

  document.body.removeChild(link);
}
</script></body>
</html>