<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>P2P Social Logo</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f4f7f8;
  font-family:Arial, sans-serif;
}

/* =========================
   BRAND
========================= */

.brand{
  display:flex;
  align-items:center;
  gap:40px;
}

/* =========================
   LOGO ICON
========================= */

.icon{
  width:220px;
  height:220px;
  border-radius:55px;

  background:linear-gradient(
    135deg,
    #064e46,
    #10a889
  );

  display:flex;
  align-items:center;
  justify-content:center;

  position:relative;

  box-shadow:
    0 18px 40px rgba(0,0,0,.15);
}

/* OUTER WHITE SHAPE */

.logo-ring{
  width:145px;
  height:105px;

  border:24px solid white;
  border-radius:45px;

  position:relative;

  display:flex;
  align-items:center;
  justify-content:center;
}

/* CENTER WHITE CIRCLE */

.center{
  width:58px;
  height:58px;

  background:white;
  border-radius:50%;

  display:flex;
  align-items:center;
  justify-content:center;
}

/* CENTER GREEN DOT */

.dot{
  width:20px;
  height:20px;

  background:#087f73;
  border-radius:50%;
}

/* =========================
   TEXT
========================= */

.text h1{
  font-size:58px;
  line-height:1;
  font-weight:800;
  white-space:nowrap;
  color:#172033;
}

.text h1 span{
  color:#087f73;
}

.text p{
  margin-top:25px;

  font-size:24px;
  letter-spacing:4px;

  color:#7b8491;

  white-space:nowrap;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px){

  .brand{
    gap:20px;
  }

  .icon{
    width:120px;
    height:120px;
    border-radius:30px;
  }

  .logo-ring{
    width:80px;
    height:58px;
    border-width:13px;
    border-radius:25px;
  }

  .center{
    width:32px;
    height:32px;
  }

  .dot{
    width:11px;
    height:11px;
  }

  .text h1{
    font-size:30px;
  }

  .text p{
    margin-top:12px;
    font-size:11px;
    letter-spacing:2px;
  }
}

@media(max-width:450px){

  .brand{
    gap:14px;
  }

  .icon{
    width:80px;
    height:80px;
    border-radius:20px;
  }

  .logo-ring{
    width:54px;
    height:39px;
    border-width:9px;
    border-radius:17px;
  }

  .center{
    width:22px;
    height:22px;
  }

  .dot{
    width:8px;
    height:8px;
  }

  .text h1{
    font-size:22px;
  }

  .text p{
    margin-top:7px;
    font-size:7px;
    letter-spacing:1.2px;
  }
}
</style>
</head>

<body>

<div class="brand">

  <!-- P2P LOGO ICON -->
  <div class="icon">

    <div class="logo-ring">

      <div class="center">
        <div class="dot"></div>
      </div>

    </div>

  </div>

  <!-- BRAND TEXT -->
  <div class="text">

    <h1>
      P2P <span>Social</span>
    </h1>

    <p>
      CONNECT • TRADE • SHARE
    </p>

  </div>

</div>

</body>
</html>