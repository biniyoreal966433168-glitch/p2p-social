// supabase/functions/create-deposit-address/index.ts

import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Content-Type": "application/json",
};

const SUPABASE_URL =
  Deno.env.get("SUPABASE_URL") ?? "";

const SUPABASE_SERVICE_ROLE_KEY =
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? "";

const supabase = createClient(
  SUPABASE_URL,
  SUPABASE_SERVICE_ROLE_KEY
);

const TRON_NETWORK = "TRON";
const TRC20_STANDARD = "TRC-20";
const USDT_ASSET = "USDT";

function json(
  body: unknown,
  status = 200
) {
  return new Response(
    JSON.stringify(body),
    {
      status,
      headers: corsHeaders,
    }
  );
}

function isValidTronAddress(
  address: string
) {
  return /^T[1-9A-HJ-NP-Za-km-z]{33}$/.test(
    address
  );
}

Deno.serve(async (req) => {

  if (req.method === "OPTIONS") {
    return new Response(
      "ok",
      {
        status: 200,
        headers: corsHeaders,
      }
    );
  }

  if (req.method !== "POST") {
    return json(
      {
        error: "Method not allowed",
      },
      405
    );
  }

  try {

    /*
    ============================================
    AUTHENTICATE USER
    ============================================
    */

    const authHeader =
      req.headers.get("Authorization");

    if (!authHeader) {
      return json(
        {
          error: "Missing Authorization header",
        },
        401
      );
    }

    const token =
      authHeader.replace(
        /^Bearer\s+/i,
        ""
      );

    if (!token) {
      return json(
        {
          error: "Missing access token",
        },
        401
      );
    }

    const {
      data: userData,
      error: userError,
    } =
      await supabase.auth.getUser(token);

    if (
      userError ||
      !userData?.user
    ) {
      return json(
        {
          error:
            userError?.message ??
            "Unauthorized",
        },
        401
      );
    }

    const userId =
      userData.user.id;


    /*
    ============================================
    READ REQUEST
    ============================================
    */

    let body: Record<string, unknown> = {};

    try {
      body = await req.json();
    } catch {
      body = {};
    }

    const requestedNetwork =
      String(
        body.network ??
        TRON_NETWORK
      ).trim();

    const requestedToken =
      String(
        body.token ??
        body.asset ??
        USDT_ASSET
      ).trim()
      .toUpperCase();

    const requestedStandard =
      String(
        body.standard ??
        TRC20_STANDARD
      ).trim();


    /*
    ============================================
    VALIDATE DEPOSIT TYPE
    ============================================
    */

    if (
      requestedNetwork !==
      TRON_NETWORK
    ) {
      return json(
        {
          error:
            "Only TRON deposits are supported.",
        },
        400
      );
    }

    if (
      requestedToken !==
      USDT_ASSET
    ) {
      return json(
        {
          error:
            "Only USDT deposits are supported.",
        },
        400
      );
    }

    if (
      requestedStandard !==
      TRC20_STANDARD
    ) {
      return json(
        {
          error:
            "Only TRC-20 deposits are supported.",
        },
        400
      );
    }


    /*
    ============================================
    CHECK EXISTING ADDRESS
    ============================================
    */

    const {
      data: existing,
      error: existingError,
    } =
      await supabase
        .from("deposit_addresses")
        .select(
          "id,user_id,blockchain,network,asset,deposit_address,status,created_at,updated_at"
        )
        .eq(
          "user_id",
          userId
        )
        .eq(
          "blockchain",
          TRON_NETWORK
        )
        .eq(
          "network",
          TRON_NETWORK
        )
        .eq(
          "asset",
          USDT_ASSET
        )
        .eq(
          "status",
          "active"
        )
        .order(
          "created_at",
          {
            ascending: false,
          }
        )
        .limit(1)
        .maybeSingle();

    if (existingError) {

      console.error(
        "Existing address lookup error:",
        existingError
      );

      return json(
        {
          error:
            "Failed to check existing deposit address.",
          details:
            existingError.message,
        },
        500
      );
    }


    /*
    ============================================
    RETURN EXISTING VALID ADDRESS
    ============================================
    */

    if (
      existing?.deposit_address &&
      isValidTronAddress(
        existing.deposit_address
      )
    ) {

      return json({
        success: true,
        address:
          existing.deposit_address,
        deposit_address:
          existing.deposit_address,
        wallet_address:
          existing.deposit_address,
        blockchain: TRON_NETWORK,
        network: TRON_NETWORK,
        asset: USDT_ASSET,
        token: USDT_ASSET,
        standard: TRC20_STANDARD,
        status:
          existing.status ?? "active",
        existing: true,
      });
    }


    /*
    ============================================
    IMPORTANT
    ============================================

    A deposit address must be generated from
    a server-side wallet/address service.

    This function does NOT put private keys
    in wallet.html.

    Set these environment variables on the
    Edge Function if using your own TRON
    deposit-address generator:

      TRON_DEPOSIT_ADDRESS
    ============================================
    */

    const configuredAddress =
      Deno.env.get(
        "TRON_DEPOSIT_ADDRESS"
      )?.trim() ?? "";


    /*
    ============================================
    USE CONFIGURED TRON DEPOSIT ADDRESS
    ============================================
    */

    if (
      configuredAddress &&
      !isValidTronAddress(
        configuredAddress
      )
    ) {

      return json(
        {
          error:
            "TRON_DEPOSIT_ADDRESS is not a valid TRON address.",
        },
        500
      );
    }


    if (configuredAddress) {

      const {
        data: inserted,
        error: insertError,
      } =
        await supabase
          .from("deposit_addresses")
          .insert({
            user_id: userId,
            blockchain: TRON_NETWORK,
            network: TRON_NETWORK,
            asset: USDT_ASSET,
            deposit_address:
              configuredAddress,
            status: "active",
          })
          .select(
            "id,user_id,blockchain,network,asset,deposit_address,status,created_at,updated_at"
          )
          .single();

      if (insertError) {

        console.error(
          "Deposit address insert error:",
          insertError
        );

        /*
        If another request created the
        address at the same time, try
        loading the existing one again.
        */

        const {
          data: retryExisting,
          error: retryError,
        } =
          await supabase
            .from("deposit_addresses")
            .select(
              "id,user_id,blockchain,network,asset,deposit_address,status,created_at,updated_at"
            )
            .eq(
              "user_id",
              userId
            )
            .eq(
              "blockchain",
              TRON_NETWORK
            )
            .eq(
              "network",
              TRON_NETWORK
            )
            .eq(
              "asset",
              USDT_ASSET
            )
            .eq(
              "status",
              "active"
            )
            .order(
              "created_at",
              {
                ascending: false,
              }
            )
            .limit(1)
            .maybeSingle();

        if (
          !retryError &&
          retryExisting?.deposit_address &&
          isValidTronAddress(
            retryExisting.deposit_address
          )
        ) {

          return json({
            success: true,
            address:
              retryExisting.deposit_address,
            deposit_address:
              retryExisting.deposit_address,
            wallet_address:
              retryExisting.deposit_address,
            blockchain:
              TRON_NETWORK,
            network:
              TRON_NETWORK,
            asset:
              USDT_ASSET,
            token:
              USDT_ASSET,
            standard:
              TRC20_STANDARD,
            status:
              retryExisting.status ??
              "active",
            existing: true,
          });
        }

        return json(
          {
            error:
              "Failed to save deposit address.",
            details:
              insertError.message,
          },
          500
        );
      }

      return json({
        success: true,
        address:
          inserted.deposit_address,
        deposit_address:
          inserted.deposit_address,
        wallet_address:
          inserted.deposit_address,
        blockchain:
          inserted.blockchain,
        network:
          inserted.network,
        asset:
          inserted.asset,
        token:
          inserted.asset,
        standard:
          TRC20_STANDARD,
        status:
          inserted.status,
        existing: false,
      });
    }


    /*
    ============================================
    NO ADDRESS PROVIDER CONFIGURED
    ============================================
    */

    return json(
      {
        error:
          "No TRON deposit address is configured for this Edge Function.",
        details:
          "Set TRON_DEPOSIT_ADDRESS as a server-side Edge Function secret, or connect this function to your server-side TRON address-generation service.",
      },
      500
    );

  } catch (error) {

    console.error(
      "create-deposit-address fatal error:",
      error
    );

    return json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Internal server error",
      },
      500
    );
  }
});