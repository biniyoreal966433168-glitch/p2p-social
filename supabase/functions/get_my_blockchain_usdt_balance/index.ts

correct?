import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods":
    "POST, OPTIONS",
};

/*
=====================================================
CONFIGURATION
=====================================================
*/

// Mainnet TronGrid endpoint.
const TRONGRID_BASE_URL =
  "https://api.trongrid.io";

// TRON mainnet USDT TRC-20 contract.
const USDT_CONTRACT =
  "TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj";

// USDT uses 6 decimal places on TRC-20.
const USDT_DECIMALS = 6;


/*
=====================================================
RESPONSE HELPERS
=====================================================
*/

function jsonResponse(
  body: unknown,
  status = 200
) {

  return new Response(
    JSON.stringify(body),
    {
      status,
      headers: {
        ...corsHeaders,
        "Content-Type":
          "application/json",
      },
    }
  );

}


/*
=====================================================
ENVIRONMENT
=====================================================
*/

const SUPABASE_URL =
  Deno.env.get("SUPABASE_URL");

const SUPABASE_SERVICE_ROLE_KEY =
  Deno.env.get(
    "SUPABASE_SERVICE_ROLE_KEY"
  );

const TRONGRID_API_KEY =
  Deno.env.get(
    "TRONGRID_API_KEY"
  );


/*
=====================================================
VALIDATE ENVIRONMENT
=====================================================
*/

if(!SUPABASE_URL){

  console.error(
    "Missing SUPABASE_URL"
  );

}

if(!SUPABASE_SERVICE_ROLE_KEY){

  console.error(
    "Missing SUPABASE_SERVICE_ROLE_KEY"
  );

}

if(!TRONGRID_API_KEY){

  console.error(
    "Missing TRONGRID_API_KEY"
  );

}


/*
=====================================================
TRON ADDRESS VALIDATION
=====================================================
*/

function isValidTronAddress(
  address: string
){

  /*
    Normal TRON mainnet Base58 addresses
    begin with T and are 34 characters long.
  */

  return /^T[1-9A-HJ-NP-Za-km-z]{33}$/
    .test(address);

}


/*
=====================================================
USDT AMOUNT CONVERSION
=====================================================
*/

function convertUsdtRawAmount(
  rawAmount: unknown
){

  const raw =
    String(
      rawAmount ?? "0"
    );

  /*
    Do not use Number() for the raw
    blockchain integer because large
    token values can lose precision.
  */

  if(!/^\d+$/.test(raw)){

    return null;

  }

  const length =
    raw.length;

  if(length <= USDT_DECIMALS){

    const padded =
      raw.padStart(
        USDT_DECIMALS + 1,
        "0"
      );

    const integerPart =
      padded.slice(
        0,
        padded.length -
          USDT_DECIMALS
      );

    const decimalPart =
      padded.slice(
        padded.length -
          USDT_DECIMALS
      );

    return Number(
      `${integerPart}.${decimalPart}`
    );

  }

  const integerPart =
    raw.slice(
      0,
      length -
        USDT_DECIMALS
    );

  const decimalPart =
    raw.slice(
      length -
        USDT_DECIMALS
    );

  return Number(
    `${integerPart}.${decimalPart}`
  );

}


/*
=====================================================
FIND USDT IN TRONGRID RESPONSE
=====================================================
*/

function findUsdtBalance(
  data: unknown
){

  if(!Array.isArray(data)){

    return null;

  }

  for(
    const token of data
  ){

    if(
      !token ||
      typeof token !== "object"
    ){

      continue;

    }

    const item =
      token as Record<
        string,
        unknown
      >;

    const contract =
      String(
        item.contract_address ??
        item.contractAddress ??
        ""
      ).trim();

    /*
      Match the official USDT contract.
    */

    if(
      contract !==
      USDT_CONTRACT
    ){

      continue;

    }

    const rawBalance =
      item.balance ??
      item.amount ??
      item.value ??
      "0";

    const balance =
      convertUsdtRawAmount(
        rawBalance
      );

    if(
      balance === null ||
      !Number.isFinite(balance)
    ){

      return null;

    }

    return balance;

  }

  /*
    Address may simply have no USDT.
  */

  return 0;

}


/*
=====================================================
MAIN HANDLER
=====================================================
*/

Deno.serve(
  async (req) => {

    /*
    -------------------------------------------------
    CORS
    -------------------------------------------------
    */

    if(
      req.method === "OPTIONS"
    ){

      return new Response(
        "ok",
        {
          status: 200,
          headers:
            corsHeaders,
        }
      );

    }


    /*
    -------------------------------------------------
    METHOD
    -------------------------------------------------
    */

    if(
      req.method !== "POST"
    ){

      return jsonResponse(
        {
          error:
            "Method not allowed."
        },
        405
      );

    }


    /*
    -------------------------------------------------
    ENVIRONMENT
    -------------------------------------------------
    */

    if(
      !SUPABASE_URL ||
      !SUPABASE_SERVICE_ROLE_KEY
    ){

      return jsonResponse(
        {
          error:
            "Supabase server configuration is incomplete."
        },
        500
      );

    }


    if(
      !TRONGRID_API_KEY
    ){

      return jsonResponse(
        {
          error:
            "TRON backend configuration is incomplete."
        },
        500
      );

    }


    /*
    -------------------------------------------------
    AUTHORIZATION HEADER
    -------------------------------------------------
    */

    const authHeader =
      req.headers.get(
        "Authorization"
      );

    if(
      !authHeader ||
      !authHeader.startsWith(
        "Bearer "
      )
    ){

      return jsonResponse(
        {
          error:
            "Authentication required."
        },
        401
      );

    }


    /*
    -------------------------------------------------
    USER CLIENT
    -------------------------------------------------
    */

    /*
      This client uses the user's JWT.

      It is used only to identify the
      authenticated user.
    */

    const userClient =
      createClient(
        SUPABASE_URL,
        Deno.env.get(
          "SUPABASE_PUBLISHABLE_KEY"
        ) ??
        Deno.env.get(
          "SUPABASE_ANON_KEY"
        ) ??
        "",
        {
          global: {
            headers: {
              Authorization:
                authHeader,
            },
          },
        }
      );


    /*
    -------------------------------------------------
    GET AUTHENTICATED USER
    -------------------------------------------------
    */

    const {
      data: userData,
      error: userError
    } =
      await userClient.auth.getUser(
        authHeader.replace(
          "Bearer ",
          ""
        )
      );


    if(
      userError ||
      !userData?.user
    ){

      console.error(
        "AUTH ERROR:",
        userError
      );

      return jsonResponse(
        {
          error:
            "Invalid or expired login session."
        },
        401
      );

    }


    const userId =
      userData.user.id;


    /*
    -------------------------------------------------
    SERVICE CLIENT
    -------------------------------------------------
    */

    /*
      Service role is used ONLY on the server.

      NEVER place this key in wallet.html.
    */

    const adminClient =
      createClient(
        SUPABASE_URL,
        SUPABASE_SERVICE_ROLE_KEY,
        {
          auth: {
            autoRefreshToken:
              false,

            persistSession:
              false,
          },
        }
      );


    /*
    -------------------------------------------------
    GET USER'S ASSIGNED DEPOSIT ADDRESS
    -------------------------------------------------
    */

    const {
      data: wallet,
      error: walletError
    } =
      await adminClient
        .from(
          "wallet_deposit_addresses"
        )
        .select(
          "id,user_id,address,network,token,standard,is_active"
        )
        .eq(
          "user_id",
          userId
        )
        .eq(
          "is_active",
          true
        )
        .maybeSingle();


    if(walletError){

      console.error(
        "WALLET ADDRESS ERROR:",
        walletError
      );

      return jsonResponse(
        {
          error:
            "Could not load your assigned deposit address."
        },
        500
      );

    }


    if(!wallet){

      return jsonResponse(
        {
          error:
            "No active TRC-20 deposit address is assigned to this user."
        },
        404
      );

    }


    /*
    -------------------------------------------------
    VERIFY ADDRESS RECORD
    -------------------------------------------------
    */

    const address =
      String(
        wallet.address ??
        ""
      ).trim();

    const network =
      String(
        wallet.network ??
        ""
      ).trim()
      .toUpperCase();

    const token =
      String(
        wallet.token ??
        ""
      ).trim()
      .toUpperCase();

    const standard =
      String(
        wallet.standard ??
        ""
      ).trim()
      .toUpperCase();


    if(
      network !== "TRON"
    ){

      return jsonResponse(
        {
          error:
            "Assigned wallet is not a TRON wallet."
        },
        400
      );

    }


    if(
      token !== "USDT"
    ){

      return jsonResponse(
        {
          error:
            "Assigned wallet is not configured for USDT."
        },
        400
      );

    }


    if(
      standard !== "TRC-20"
    ){

      return jsonResponse(
        {
          error:
            "Assigned wallet is not configured for TRC-20."
        },
        400
      );

    }


    if(
      !isValidTronAddress(
        address
      )
    ){

      return jsonResponse(
        {
          error:
            "Assigned deposit address is not a valid TRON address."
        },
        400
      );

    }


    /*
    -------------------------------------------------
    TRONGRID REQUEST
    -------------------------------------------------
    */

    const tronUrl =
      new URL(
        `${TRONGRID_BASE_URL}/v1/accounts/${encodeURIComponent(address)}/trc20/balance`
      );

    /*
      Restrict the result to the USDT contract.
    */

    tronUrl.searchParams.set(
      "contract_address",
      USDT_CONTRACT
    );

    tronUrl.searchParams.set(
      "limit",
      "20"
    );


    let tronResponse: Response;

    try{

      tronResponse =
        await fetch(
          tronUrl.toString(),
          {
            method:
              "GET",

            headers: {
              "TRON-PRO-API-KEY":
                TRONGRID_API_KEY,

              "Accept":
                "application/json",
            },
          }
        );

    }catch(error){

      console.error(
        "TRONGRID NETWORK ERROR:",
        error
      );

      return jsonResponse(
        {
          error:
            "Unable to connect to the TRON blockchain service."
        },
        502
      );

    }


    /*
    -------------------------------------------------
    TRONGRID HTTP STATUS
    -------------------------------------------------
    */

    if(
      !tronResponse.ok
    ){

      const body =
        await tronResponse
          .text();

      console.error(
        "TRONGRID ERROR:",
        tronResponse.status,
        body
      );

      return jsonResponse(
        {
          error:
            "TRON blockchain lookup failed."
        },
        502
      );

    }


    /*
    -------------------------------------------------
    PARSE TRONGRID JSON
    -------------------------------------------------
    */

    let tronData: unknown;

    try{

      tronData =
        await tronResponse.json();

    }catch(error){

      console.error(
        "TRONGRID JSON ERROR:",
        error
      );

      return jsonResponse(
        {
          error:
            "Invalid response from TRON blockchain service."
        },
        502
      );

    }


    /*
    -------------------------------------------------
    EXTRACT USDT
    -------------------------------------------------
    */

    const responseObject =
      (
        tronData &&
        typeof tronData ===
          "object"
      )
        ? tronData as Record<
            string,
            unknown
          >
        : null;


    const balances =
      responseObject?.data;


    const usdtBalance =
      findUsdtBalance(
        balances
      );


    if(
      usdtBalance === null
    ){

      console.error(
        "Could not parse USDT balance:",
        tronData
      );

      return jsonResponse(
        {
          error:
            "Could not read the USDT balance returned by TRON."
        },
        502
      );

    }


    /*
    -------------------------------------------------
    FINAL RESPONSE
    -------------------------------------------------
    */

    return jsonResponse(
      {
        success: true,

        address,

        network:
          "TRON",

        token:
          "USDT",

        standard:
          "TRC-20",

        contract_address:
          USDT_CONTRACT,

        decimals:
          USDT_DECIMALS,

        usdt_balance:
          usdtBalance,

        blockchain_balance:
          usdtBalance,

        verified:
          true,

        source:
          "TronGrid",

        checked_at:
          new Date()
            .toISOString()
      },
      200
    );

  }
);